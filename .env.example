# Project configuration — copy to .env and fill in your values

# Compose files. Local development adds docker-compose.dev.yml, which mounts
# the code from this directory into the containers. Servers use only
# docker-compose.yml, which runs the code baked into the images; deploy/setup.sh
# sets that, and deploys refuse to run with the development file.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Prefix for container and image names
APP_NAME=wildland-eco

# Host ports, bound to 127.0.0.1 only
NGINX_PORT=8080
DB_PORT=5432

# User and group IDs the app, queue, scheduler, node, and webhook containers run as.
# Match the owner of this directory (run `id -u` and `id -g`) so files they create stay editable.
UID=1000
GID=1000

DB_CONNECTION=pgsql
DB_DATABASE=wildland-eco
DB_USERNAME=wildland-eco
DB_PASSWORD=changeme

# Servers only; see docs/07-deployment.md. Keep comments on their own lines:
# deploy/deploy.sh reads these values literally.
#
# Starts the caddy and webhook services
# COMPOSE_PROFILES=server
#
# Caddy config to use, deploy/caddy/<CADDY_SITE>.Caddyfile: staging or production
# CADDY_SITE=staging
#
# Branch to deploy: main for staging, release for production
# DEPLOY_BRANCH=main
#
# GitHub webhook secret; generate with `openssl rand -hex 32`
# WEBHOOK_SECRET=
#
# The running release's image tag (its commit). Set by each deploy; change it
# by hand only to roll back (see docs/07-deployment.md).
# IMAGE_TAG=
