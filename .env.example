# Project configuration — copy to .env and fill in your values

# Prefix for container names
APP_NAME=wildland-eco

# Host ports, bound to 127.0.0.1 only
NGINX_PORT=8080
DB_PORT=5432

# User and group IDs the app and node containers run as. Match the owner of
# this directory (run `id -u` and `id -g`) so files they create stay editable.
UID=1000
GID=1000

DB_CONNECTION=pgsql
DB_DATABASE=wildland-eco
DB_USERNAME=wildland-eco
DB_PASSWORD=changeme

# Servers only: the branch deploy/deploy.sh deploys (main for staging, release for production)
# DEPLOY_BRANCH=main
