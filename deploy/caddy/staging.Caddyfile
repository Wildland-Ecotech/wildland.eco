# Staging server: https://stage.wildland.eco
#
# Caddy obtains and renews the HTTPS certificate automatically and
# redirects HTTP to HTTPS. Selected by CADDY_SITE=staging in the root .env.

{
	email contact@wildland.eco

	# Visitors' own addresses, from behind Cloudflare
	import /etc/caddy/cloudflare.caddy
}

# The proxy_to_site, maintenance_page, and access_log snippets
import /etc/caddy/site.caddy

stage.wildland.eco {
	encode zstd gzip
	import access_log

	# Keep the staging site out of search results
	header X-Robots-Tag "noindex, nofollow"

	# GitHub push webhooks; see deploy/webhook/hooks.json
	handle /hooks/* {
		reverse_proxy webhook:9000
	}

	handle {
		import proxy_to_site
	}

	import maintenance_page
}
